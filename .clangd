CompileFlags:
  CompilationDatabase: ./build/clang-x64-debug/

Diagnostics:
  Suppress:
    [
      attributes_not_allowed,
      unused-includes,
      missing-declarations,
      builtin_definition,
    ]

InlayHints:
  BlockEnd: true
  Designators: true
  Enabled: true
  ParameterNames: false
  DeducedTypes: true
  TypeNameLimit: 24

---
If:
  PathMatch:
    - thirdparty/nanobench/src/comparisons/.*
    - thirdparty/nanobench/src/test/.*
Index:
  Background: Skip
Diagnostics:
  Suppress: "*"
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    Remove: "*"

